<Project>
  <!-- App-only import. Execution-time guards; configuration is not signing permission.
       Android 36.1.118 Xamarin.Android.Common.targets: _BuildApkEmbed and _CopyPackage.
       Separate targets recheck effective properties at compilation and each package boundary. -->
  <Target Name="PredictValidateCompileProfile" BeforeTargets="CoreCompile" Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <Error Code="PREDICT001" Condition="!$([System.String]::Equals('$(PredictBuildProfile)', 'Dev')) And !$([System.String]::Equals('$(PredictBuildProfile)', 'Production'))" Text="PredictBuildProfile must be explicitly Dev or Production (case-sensitive)." />
    <Error Code="PREDICT002" Condition="('$(PredictBuildProfile)' == 'Dev' And !$([System.String]::Equals('$(PredictTestAds)', 'true'))) Or ('$(PredictBuildProfile)' == 'Production' And !$([System.String]::Equals('$(PredictTestAds)', 'false')))" Text="Dev requires explicit true; Production requires explicit false for PredictTestAds." />
    <Error Code="PREDICT003" Condition="'$(PredictBuildProfile)' == 'Production' And !$([System.String]::Equals('$(Configuration)', 'Release'))" Text="Production requires Release." />
    <Error Code="PREDICT004" Condition="'$(PredictBuildProfile)' == 'Production' And $([System.Text.RegularExpressions.Regex]::IsMatch('$(DefineConstants)', '(^|[;,])\s*(DEBUG|PREDICT_TEST_ADS)\s*([;,]|$)'))" Text="Production forbids exact DEBUG and PREDICT_TEST_ADS tokens." />
    <Error Code="PREDICT005" Condition="'$(PredictBuildProfile)' == 'Dev' And !$([System.Text.RegularExpressions.Regex]::IsMatch('$(DefineConstants)', '(^|[;,])\s*(DEBUG|PREDICT_TEST_ADS)\s*([;,]|$)'))" Text="Dev requires an effective DEBUG or PREDICT_TEST_ADS token." />
    <Error Code="PREDICT006" Condition="'$(PredictBuildProfile)' == 'Production' And ('$(AndroidPackageFormats)' != 'aab' Or '$(AndroidPackageFormat)' != 'aab' Or '$(TargetFramework)' != 'net10.0-android36.0' Or '$(TargetPlatformIdentifier)' != 'android' Or '$(TargetPlatformVersion)' != '36.0' Or '$(SupportedOSPlatformVersion)' != '26.0' Or '$(RuntimeIdentifier)' != 'android-arm64' Or ('$(RuntimeIdentifiers)' != '' And '$(RuntimeIdentifiers)' != 'android-arm64') Or ('$(AndroidSupportedAbis)' != '' And '$(AndroidSupportedAbis)' != 'arm64-v8a') Or !$([System.String]::Equals('$(ApplicationId)', 'hu.dorian.predict')) Or '$(_AndroidAdditionalPackageFormats)' != '')" Text="Production requires API36/min26/ARM64/hu.dorian.predict and AAB-only effective packaging." />
  </Target>
  <Target Name="PredictValidatePackageProfile" BeforeTargets="_BuildApkEmbed" Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <Error Code="PREDICT001" Condition="!$([System.String]::Equals('$(PredictBuildProfile)', 'Dev')) And !$([System.String]::Equals('$(PredictBuildProfile)', 'Production'))" Text="PredictBuildProfile must be explicitly Dev or Production (case-sensitive)." />
    <Error Code="PREDICT002" Condition="('$(PredictBuildProfile)' == 'Dev' And !$([System.String]::Equals('$(PredictTestAds)', 'true'))) Or ('$(PredictBuildProfile)' == 'Production' And !$([System.String]::Equals('$(PredictTestAds)', 'false')))" Text="Dev requires explicit true; Production requires explicit false for PredictTestAds." />
    <Error Code="PREDICT003" Condition="'$(PredictBuildProfile)' == 'Production' And !$([System.String]::Equals('$(Configuration)', 'Release'))" Text="Production requires Release." />
    <Error Code="PREDICT004" Condition="'$(PredictBuildProfile)' == 'Production' And $([System.Text.RegularExpressions.Regex]::IsMatch('$(DefineConstants)', '(^|[;,])\s*(DEBUG|PREDICT_TEST_ADS)\s*([;,]|$)'))" Text="Production forbids exact DEBUG and PREDICT_TEST_ADS tokens." />
    <Error Code="PREDICT005" Condition="'$(PredictBuildProfile)' == 'Dev' And !$([System.Text.RegularExpressions.Regex]::IsMatch('$(DefineConstants)', '(^|[;,])\s*(DEBUG|PREDICT_TEST_ADS)\s*([;,]|$)'))" Text="Dev requires an effective DEBUG or PREDICT_TEST_ADS token." />
    <Error Code="PREDICT006" Condition="'$(PredictBuildProfile)' == 'Production' And ('$(AndroidPackageFormats)' != 'aab' Or '$(AndroidPackageFormat)' != 'aab' Or '$(TargetFramework)' != 'net10.0-android36.0' Or '$(TargetPlatformIdentifier)' != 'android' Or '$(TargetPlatformVersion)' != '36.0' Or '$(SupportedOSPlatformVersion)' != '26.0' Or '$(RuntimeIdentifier)' != 'android-arm64' Or ('$(RuntimeIdentifiers)' != '' And '$(RuntimeIdentifiers)' != 'android-arm64') Or ('$(AndroidSupportedAbis)' != '' And '$(AndroidSupportedAbis)' != 'arm64-v8a') Or !$([System.String]::Equals('$(ApplicationId)', 'hu.dorian.predict')) Or '$(_AndroidAdditionalPackageFormats)' != '')" Text="Production requires API36/min26/ARM64/hu.dorian.predict and AAB-only effective packaging." />
  </Target>
  <Target Name="PredictValidateHandoffProfile" BeforeTargets="_CopyPackage" Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <Error Code="PREDICT001" Condition="!$([System.String]::Equals('$(PredictBuildProfile)', 'Dev')) And !$([System.String]::Equals('$(PredictBuildProfile)', 'Production'))" Text="PredictBuildProfile must be explicitly Dev or Production (case-sensitive)." />
    <Error Code="PREDICT002" Condition="('$(PredictBuildProfile)' == 'Dev' And !$([System.String]::Equals('$(PredictTestAds)', 'true'))) Or ('$(PredictBuildProfile)' == 'Production' And !$([System.String]::Equals('$(PredictTestAds)', 'false')))" Text="Dev requires explicit true; Production requires explicit false for PredictTestAds." />
    <Error Code="PREDICT003" Condition="'$(PredictBuildProfile)' == 'Production' And !$([System.String]::Equals('$(Configuration)', 'Release'))" Text="Production requires Release." />
    <Error Code="PREDICT004" Condition="'$(PredictBuildProfile)' == 'Production' And $([System.Text.RegularExpressions.Regex]::IsMatch('$(DefineConstants)', '(^|[;,])\s*(DEBUG|PREDICT_TEST_ADS)\s*([;,]|$)'))" Text="Production forbids exact DEBUG and PREDICT_TEST_ADS tokens." />
    <Error Code="PREDICT005" Condition="'$(PredictBuildProfile)' == 'Dev' And !$([System.Text.RegularExpressions.Regex]::IsMatch('$(DefineConstants)', '(^|[;,])\s*(DEBUG|PREDICT_TEST_ADS)\s*([;,]|$)'))" Text="Dev requires an effective DEBUG or PREDICT_TEST_ADS token." />
    <Error Code="PREDICT006" Condition="'$(PredictBuildProfile)' == 'Production' And ('$(AndroidPackageFormats)' != 'aab' Or '$(AndroidPackageFormat)' != 'aab' Or '$(TargetFramework)' != 'net10.0-android36.0' Or '$(TargetPlatformIdentifier)' != 'android' Or '$(TargetPlatformVersion)' != '36.0' Or '$(SupportedOSPlatformVersion)' != '26.0' Or '$(RuntimeIdentifier)' != 'android-arm64' Or ('$(RuntimeIdentifiers)' != '' And '$(RuntimeIdentifiers)' != 'android-arm64') Or ('$(AndroidSupportedAbis)' != '' And '$(AndroidSupportedAbis)' != 'arm64-v8a') Or !$([System.String]::Equals('$(ApplicationId)', 'hu.dorian.predict')) Or '$(_AndroidAdditionalPackageFormats)' != '')" Text="Production requires API36/min26/ARM64/hu.dorian.predict and AAB-only effective packaging." />
  </Target>
</Project>
